# Configuração via variáveis de ambiente do terminal/serviço; este arquivo não é carregado automaticamente.
AMBAR_ENV=development
AMBAR_PORT=8093
AMBAR_ORIGIN=http://127.0.0.1:8093
AMBAR_DB=output/ambar.sqlite3
# Somente uma instância deve executar os ciclos. Instâncias HTTP extras usam 0.
AMBAR_WORKER=1
# Habilite somente após avaliação da finalidade e das condições oficiais de uso.
AMBAR_DATAJUD_HABILITADO=0
DATAJUD_API_KEY=
# 0 usa conexão direta com TLS verificado; 1 herda proxies do ambiente.
AMBAR_DATAJUD_USAR_PROXY=0
AMBAR_BACKUP_AUTOMATICO=0
AMBAR_BACKUP_DIR=output/backups
# Somente produção: configure conta e provedor SMTP antes de habilitar uso real.
AMBAR_SMTP_HOST=
AMBAR_SMTP_PORT=587
AMBAR_SMTP_USER=
AMBAR_SMTP_PASSWORD=
AMBAR_EMAIL_FROM=
